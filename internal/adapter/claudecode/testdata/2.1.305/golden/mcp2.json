{
    "mcpServers": {
        "github": {
            "type": "http",
            "url": "https://api.githubcopilot.com/mcp/",
            "headers": {
                "Authorization": "Bearer ${GITHUB_TOKEN}"
            }
        },
        "local-db": {"type": "stdio", "command": "npx", "args": ["-y", "db-server"]},
        "forge": {
            "type": "stdio",
            "command": "forge",
            "args": [
                "mcp",
                "serve",
                "--client",
                "claude-code"
            ]
        },
        "late-add": {
            "type": "sse",
            "url": "https://example.com/sse"
        }
    }
}
